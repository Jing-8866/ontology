    <!-- http://www.example.org/library#hasISBN -->

    <owl:DatatypeProperty rdf:about="http://www.example.org/library#hasISBN">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
