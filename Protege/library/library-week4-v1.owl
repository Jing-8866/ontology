    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.example.org/library#AI_Book_01 -->

    <owl:NamedIndividual rdf:about="http://www.example.org/library#AI_Book_01">
        <rdf:type rdf:resource="http://www.example.org/library#Book"/>
        <library:hasAuthor rdf:resource="http://www.example.org/library#ZhangSan"/>
        <library:hasISBN>978-XXXX</library:hasISBN>
        <library:hasTitle>人工智能导论</library:hasTitle>
        <library:hasYear rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2023</library:hasYear>
    </owl:NamedIndividual>
    


    <!-- http://www.example.org/library#ZhangSan -->

    <owl:NamedIndividual rdf:about="http://www.example.org/library#ZhangSan">
        <rdf:type rdf:resource="http://www.example.org/library#Author"/>
    </owl:NamedIndividual>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // General axioms
