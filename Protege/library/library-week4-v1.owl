    <!-- http://www.example.org/library#belongsToCategory -->

    <owl:ObjectProperty rdf:about="http://www.example.org/library#belongsToCategory">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/library#Book"/>
        <rdfs:range rdf:resource="http://www.example.org/library#Category"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/library#hasAuthor -->

    <owl:ObjectProperty rdf:about="http://www.example.org/library#hasAuthor">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/library#Book"/>
        <rdfs:range rdf:resource="http://www.example.org/library#Author"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/library#publishedBy -->

    <owl:ObjectProperty rdf:about="http://www.example.org/library#publishedBy">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/library#Book"/>
        <rdfs:range rdf:resource="http://www.example.org/library#Publisher"/>
