    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.example.org/library#Author -->

    <owl:Class rdf:about="http://www.example.org/library#Author">
        <rdfs:subClassOf rdf:resource="http://www.example.org/library#Person"/>
    </owl:Class>
    


    <!-- http://www.example.org/library#Book -->

    <owl:Class rdf:about="http://www.example.org/library#Book"/>
    


    <!-- http://www.example.org/library#Category -->

